# 本系統(workshop 平台)自己的 MongoDB Atlas 連線字串(存放 secret collection)
SYSTEM_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# 本系統資料庫與 secret collection 名稱
SYSTEM_DB_NAME=workshop_system
SECRET_COLLECTION=secret

# 使用者 workshop 用的資料庫 / collection
WORKSHOP_DB_NAME=workshop
WORKSHOP_COLLECTION=restaurant
EXPECTED_RESTAURANT_COUNT=4292

# 使用者 Atlas 需具備的 index 名稱
VECTOR_INDEX_NAME=restaurant_auto_index
SEARCH_INDEX_NAME=restaurant_sindex

# 搜尋設定
# 向量搜尋(Auto-Embedding)的文字欄位(index path)
VECTOR_SEARCH_PATH=embedding_text
# 關鍵字搜尋($search)比對的文字欄位
KEYWORD_SEARCH_PATH=embedding_text
# 搜尋預設回傳筆數
SEARCH_LIMIT=10
# VoyageAI Reranker 模型
RERANK_MODEL=rerank-2.5
# Reranker 取出文字內容用來比對的欄位
RERANK_DOCUMENT_PATH=embedding_text

# 允許的前端來源(CORS),多個以逗號分隔
# 用伺服器公有 IP / 域名存取時,請把該來源也加進來,例如:
#   CORS_ORIGINS=http://localhost:3000,http://18.142.237.50:3000
CORS_ORIGINS=http://localhost:3000

# restaurant.json 路徑(相對於 backend 目錄)
RESTAURANT_JSON_PATH=data/restaurant.json
